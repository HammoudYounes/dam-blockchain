# ---------------------------------------------------------------------------
# T2 API — environment. Copy to .env and fill the secrets.
# Every var here is validated at boot by ConfigModule (B0.3); a missing one
# fails startup loudly rather than surfacing as a 500 later.
# ---------------------------------------------------------------------------

PORT=3001

# --- Database (T2) ---------------------------------------------------------
# Host form: the app runs on the host/WSL, Postgres runs in Docker (compose.yaml).
# From INSIDE the compose network instead, use host `postgres` not `localhost`.
# Credentials and port must match the postgres service defaults in compose.yaml.
DATABASE_URL="postgresql://dam:dam_dev_password@localhost:5432/dam?schema=public"

# Consumed by compose.yaml. Override here only if you change the defaults above.
POSTGRES_USER=dam
POSTGRES_PASSWORD=dam_dev_password
POSTGRES_DB=dam
POSTGRES_PORT=5432

# --- Hashing service (T3) --------------------------------------------------
HASHING_SERVICE_URL=http://localhost:8001

# --- Chain (T5) — Polygon Amoy, matches contracts/.env ---------------------
CHAIN_ID=80002
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# The service wallet that PAYS GAS for mint/register. Never a user key.
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here

# Deployed + verified on Amoy. Var names align with contracts/.env.
DAM_ASSET_ADDRESS=0xE7127207eB3E24B34021344aCB7D7Cff5D092A59
DAM_SIGNATURE_ADDRESS=0xA55Ba1468967ad3a11adD593eA702673cc66d660
DAM_VERIFIER_ADDRESS=0x1524c7e44fDad13f4288b36Fca468647002DbecF

# --- IPFS / Pinata (T4) ----------------------------------------------------
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your_pinata_gateway_here

# --- Auth ------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here

# --- Image upload ----------------------------------------------------------
# Bytes. 10 MiB. Enforced in B5.1 alongside content-sniffing.
MAX_UPLOAD_SIZE=10485760
