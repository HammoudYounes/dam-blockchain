// DAM Backend — persistence layer (B8.1)
//
// The chain is authoritative for ownership and proof of authorship. Everything here is
// either a labelled projection of chain state or operational state the chain cannot hold.
// See DESIGN.md §7 for the decision record and the logical schema this implements.
//
// Conventions: snake_case tables/columns via @map, UUID v7 surrogate keys, citext for
// addresses, timestamptz everywhere. Tx hashes are varchar(66) + a CHECK, never char(66) —
// bpchar pads with spaces and compares by different rules.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AssetStatus {
  draft // row exists, nothing on chain yet
  minting // saga in flight
  registered // minted AND signature registered
  failed // saga gave up; compensations applied

  @@map("asset_status")
}

enum FingerprintAlgorithm {
  phash // canonical 64-bit — the only one anchored on chain
  ahash
  dhash
  hsv
  rhash
  chash

  @@map("fingerprint_algorithm")
}

/// Lifecycle of the saga. Distinct from MintStep, which says *where* it is.
/// `orphaned` is the state that justifies this whole table: the NFT is minted but
/// registerSignature() has not landed. It can only be rolled forward.
enum MintJobStatus {
  running
  stalled // retryable failure, worker will pick it up
  orphaned // mintAsset() mined, registerSignature() did not — never roll back

  /// Terminal and NOT retryable, unlike `orphaned`. The token is minted but its
  /// tokenId or pHash slot was already consumed by a third party — DESIGN.md §8.1
  /// makes this cheap and permanent, and there is no admin path to undo it.
  /// Kept out of mint_jobs_resumable_idx so the worker never spins on it.
  unregisterable

  failed // terminal; compensations applied
  done

  @@map("mint_job_status")
}

/// `indexing` is a real step, not bookkeeping: DESIGN.md §4 puts POST /index after
/// registerSignature. Without it in the saga a failed call to T3 is lost silently and
/// the asset becomes invisible to every future similarity search.
enum MintStep {
  pinning_image
  pinning_metadata
  minting
  registering
  indexing
  done

  @@map("mint_step")
}

enum VerificationKind {
  ownership
  similarity

  @@map("verification_kind")
}

// ---------------------------------------------------------------------------
// users
// ---------------------------------------------------------------------------

/// Created on first successful /auth/login (B4.2). A convenience join target —
/// never a permission source. Authorisation is always "did this address sign?".
model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  walletAddress String    @unique @map("wallet_address") @db.Citext
  displayName   String?   @map("display_name")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)

  mintJobs MintJob[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// auth_nonces
// ---------------------------------------------------------------------------

/// Login challenges (B4.1). DESIGN.md §9 flags Redis with native EXPIRE as the better
/// home once B10.2 lands a compose file — until then a table with a sweep works.
///
/// Deliberately keyed on address, not userId: the first-ever login has no user row yet.
model AuthNonce {
  id      String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  address String @db.Citext

  /// The random challenge embedded in the SIWE message.
  nonce String @unique

  /// Single-use. Set on successful /auth/login; a nonce with this set is rejected even
  /// before the TTL expires, which is what stops replay.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // The expiry sweep only. The login lookup is served by auth_nonces_live_idx
  // (partial, WHERE consumed_at IS NULL) in prisma/sql/init.sql — an index leading
  // with `address` cannot serve DELETE ... WHERE expires_at < now().
  @@index([expiresAt])
  @@map("auth_nonces")
}

// ---------------------------------------------------------------------------
// assets
// ---------------------------------------------------------------------------

/// Projection of chain state + off-chain descriptive data. The row exists BEFORE the
/// token does (DESIGN.md §7) so a crash mid-saga is always recoverable — the id created
/// here is the `uploadId` handed to the client and the `assetId` handed to T3 (§6).
///
/// There is deliberately no `userId` FK. The indexer writes rows for transfers made
/// directly on Polygonscan by wallets that never logged in — the address join is
/// load-bearing, not laziness.
model Asset {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// NULL while the mint is in flight. Postgres treats NULLs as distinct, so a plain
  /// UNIQUE gives the partial-unique semantics of DESIGN.md §7 with no extra DDL.
  tokenId BigInt? @unique @map("token_id")

  /// Mirrors creatorOf() — immutable once set. May disagree with
  /// asset_signatures.signerAddress; DESIGN.md §8.3 says to surface that as suspect.
  /// Derivable by join, so no denormalised flag here.
  creatorAddress String @map("creator_address") @db.Citext

  /// Mirrors ownerOf(). WRITTEN BY THE INDEXER ONLY (B8.4). Never set from the
  /// request path, or a transfer made outside the app silently desyncs.
  ownerAddress String @map("owner_address") @db.Citext

  imageCid    String? @map("image_cid")
  metadataCid String? @map("metadata_cid")
  tokenUri    String? @unique @map("token_uri")

  title       String?
  description String?

  mimeType String? @map("mime_type")
  byteSize Int?    @map("byte_size")
  width    Int?
  height   Int?

  status AssetStatus @default(draft)

  mintTxHash      String? @map("mint_tx_hash") @db.VarChar(66)
  signatureTxHash String? @map("signature_tx_hash") @db.VarChar(66)

  mintedAtBlock BigInt? @map("minted_at_block")

  /// Block height this row was reconciled to. Returned on every /dashboard response —
  /// this is the staleness contract (DESIGN.md §1). NULL until B8.4 ships.
  indexedAtBlock BigInt? @map("indexed_at_block")

  /// When T3 last confirmed POST /index for this asset. NULL means it is NOT in the
  /// similarity index and will never be returned as a candidate. T3 owns no durable
  /// business state (DESIGN.md §1), so if we do not track membership here, nothing does.
  indexedInT3At DateTime? @map("indexed_in_t3_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fingerprints AssetFingerprint[]
  signature    AssetSignature?
  mintJob      MintJob?

  // The two /dashboard queries. `id` is the keyset tiebreaker required by B8.2 —
  // without it, rows sharing a created_at force a Sort node on top of the scan.
  @@index([creatorAddress, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerAddress, createdAt(sort: Desc), id(sort: Desc)])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// asset_fingerprints
// ---------------------------------------------------------------------------

/// Off-chain only. Six fingerprints per asset here; exactly one bytes32 on chain.
///
/// NOT a search structure — DESIGN.md §7 is explicit, and B8.5 (the popcount candidate
/// search) was removed because the similarity index lives in T3. This table exists for
/// audit and reproducibility: `algoVersion` + `bitLength` are what let a past distance
/// be recomputed years later, and T3 persists neither.
model AssetFingerprint {
  assetId     String               @map("asset_id") @db.Uuid
  algorithm   FingerprintAlgorithm
  algoVersion String               @map("algo_version")

  /// Raw hash bits.
  bits Bytes

  /// REQUIRED, not padding. The benchmark CSVs normalise over different denominators
  /// per algorithm (dhash /72, hsv /42, phash /63). Assuming a uniform 64 silently
  /// corrupts every distance calculation downstream.
  bitLength Int @map("bit_length") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, algorithm, algoVersion])
  @@map("asset_fingerprints")
}

// ---------------------------------------------------------------------------
// asset_signatures
// ---------------------------------------------------------------------------

/// Read-through mirror of DAMSignature, so GET /signature/:tokenId and duplicate
/// pre-checks skip an RPC round trip. Written ONLY after the chain confirms — the
/// in-flight copy of the same signature lives on mint_jobs.
///
/// VERIFICATION NEVER READS THIS TABLE. B7.1 always calls verifySignatureView().
model AssetSignature {
  assetId String @id @map("asset_id") @db.Uuid

  /// Mirrors _registeredHashes. 32 bytes.
  perceptualHash Bytes @unique @map("perceptual_hash")

  sigR Bytes @map("sig_r")
  sigS Bytes @map("sig_s")
  sigV Int   @map("sig_v") @db.SmallInt

  /// The `creator` argument as it was passed to registerSignature(). DESIGN.md §8.3:
  /// the two contracts share no reference, so this can differ from
  /// DAMAsset.creatorOf() and therefore from assets.creatorAddress. Stored explicitly
  /// because verifySignatureView() validates against THIS address, not creatorOf().
  signerAddress String @map("signer_address") @db.Citext

  registeredAtChain DateTime @map("registered_at_chain") @db.Timestamptz(6)
  txHash            String   @map("tx_hash") @db.VarChar(66)
  blockNumber       BigInt   @map("block_number")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_signatures")
}

// ---------------------------------------------------------------------------
// mint_jobs
// ---------------------------------------------------------------------------

/// The saga log (DESIGN.md §4.3). Once mintAsset() is mined the NFT is permanent, so a
/// failure in registerSignature() can only be rolled *forward*. This row is what makes
/// that retry survive a process restart.
///
/// Retries are safe by construction: registerSignature reverts on a duplicate
/// tokenId/pHash, so re-running a completed step is a no-op.
model MintJob {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// One job produces at most one asset.
  assetId String @unique @map("asset_id") @db.Uuid

  /// Client-supplied. Stops a double-submitted upload from reverting at the contract
  /// and burning gas on an opaque error. _registeredURIs alone will not prevent this —
  /// two pins of identical bytes yield the same CID.
  idempotencyKey String @unique @map("idempotency_key")

  status      MintJobStatus @default(running)
  currentStep MintStep      @default(pinning_image) @map("current_step")

  // -------------------------------------------------------------------------
  // Everything registerSignature(tokenId, pHash, r, s, v, creator) needs.
  //
  // Without these the `orphaned` state is undischargeable: the worker would know a
  // token is minted-but-unproven and have no signature to register, forcing the user
  // to sign again — which is exactly the failure this table exists to prevent.
  // They cannot live on asset_signatures: that row mirrors CONFIRMED chain state and
  // its tx_hash / block_number / registered_at_chain are NOT NULL.
  //
  // NOT NULL: both values are in hand when the job is created at POST /nft/mint.
  // Never expose perceptualHash before registerSignature lands (DESIGN.md §8.1).
  // -------------------------------------------------------------------------
  perceptualHash Bytes @map("perceptual_hash")
  sigR           Bytes @map("sig_r")
  sigS           Bytes @map("sig_s")
  sigV           Int   @map("sig_v") @db.SmallInt

  imageCid    String? @map("image_cid")
  metadataCid String? @map("metadata_cid")
  tokenId     BigInt? @map("token_id")

  mintTxHash      String? @map("mint_tx_hash") @db.VarChar(66)
  signatureTxHash String? @map("signature_tx_hash") @db.VarChar(66)

  attemptCount Int     @default(0) @map("attempt_count")
  lastError    String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // The resume worker's query is a partial index — see prisma/sql/init.sql.
  // This plain index covers the operator-facing "show me failed jobs" case.
  @@index([status, updatedAt(sort: Desc)])
  @@map("mint_jobs")
}

// ---------------------------------------------------------------------------
// verifications
// ---------------------------------------------------------------------------

/// Audit log (access pattern A9, DESIGN.md §7.1). VerificationPerformed is emitted on
/// chain but cannot be queried by requester or date.
///
/// No FK to assets: a verification may target a token we have not indexed yet, or one
/// minted outside this app entirely. Rejecting those would make the audit log lie.
model Verification {
  id   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind VerificationKind

  /// NULL for unauthenticated verification — /verify is a public route.
  requesterAddress String? @map("requester_address") @db.Citext

  /// NULL for similarity searches, which target no particular token.
  tokenId BigInt? @map("token_id")

  submittedHash Bytes @map("submitted_hash")

  /// Ownership verdict. NULL for similarity.
  result Boolean?

  /// Top-1 copy probability, denormalised for cheap listing. The full ranked list is
  /// in verification_candidates. NULL for ownership.
  similarityScore Decimal? @map("similarity_score") @db.Decimal(5, 4)

  /// Retraining the combiner changes past verdicts. A dispute needs to know which
  /// model produced which answer.
  modelVersion String? @map("model_version")

  /// NULL on the free verifySignatureView() path; set only when someone pays for the
  /// on-chain audit trail.
  onchainTxHash String? @map("onchain_tx_hash") @db.VarChar(66)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  candidates VerificationCandidate[]

  @@index([requesterAddress, createdAt(sort: Desc)])
  @@index([tokenId, createdAt(sort: Desc)])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// verification_candidates
// ---------------------------------------------------------------------------

/// The k candidates a similarity search actually returned (DESIGN.md §5.2).
///
/// A single scalar on `verifications` records that a search happened and how high the
/// top score was, but not *what it matched*. A dispute — the stated reason the audit
/// log exists — needs the ranked list as it was served.
///
/// No FK to assets, for the same reason `verifications` has none: T3 may return an
/// assetId that has since been deleted, or that was never ours. The log records what
/// was answered, not what is still true.
model VerificationCandidate {
  verificationId String @map("verification_id") @db.Uuid

  /// 1-based position in the response. Part of the PK, so a verification cannot carry
  /// two candidates at the same rank.
  rank Int

  assetId String @map("asset_id") @db.Uuid

  /// Copy probability from the combiner for this pair.
  score Decimal @db.Decimal(5, 4)

  /// Raw recall-stage distance from T3's ANN index. Squared L2 over unit-normalised
  /// embeddings, so it is in [0, 4] — NOT a similarity in [0, 1]. Kept because the
  /// two stages can disagree and a dispute may need to see that.
  annDistance Float? @map("ann_distance")

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@id([verificationId, rank])
  @@index([assetId])
  @@map("verification_candidates")
}

// ---------------------------------------------------------------------------
// chain_sync_cursor
// ---------------------------------------------------------------------------

/// Indexer bookmark, one row per contract. Without it, restarting the indexer means
/// replaying from the deployment block.
///
/// last_processed_block is advanced in the SAME transaction that applies the logs, and
/// stays ~30 blocks behind head to absorb reorgs (TASKS.md B8.4). Seeded at boot from
/// the contract addresses in env — not from a migration, which would freeze them.
model ChainSyncCursor {
  contractName       String   @id @map("contract_name")
  contractAddress    String   @map("contract_address") @db.Citext
  lastProcessedBlock BigInt   @map("last_processed_block")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chain_sync_cursor")
}

// ---------------------------------------------------------------------------
// processed_logs
// ---------------------------------------------------------------------------

/// Indexer idempotency (DESIGN.md §8.2, TASKS.md B8.4).
///
/// `chain_sync_cursor` alone is not enough. The cursor trails head by ~30 blocks to
/// absorb reorgs, so the same log is *read* many times before it is final, and a crash
/// mid-batch re-reads it again. Convergent writes like `assets.ownerAddress` survive
/// that by luck; anything that INSERTs — an AssetRegistered landing in
/// asset_signatures — does not.
///
/// Written in the same transaction that applies the log. Rows below the reorg horizon
/// are prunable, which is what the blockNumber index is for.
model ProcessedLog {
  txHash   String @map("tx_hash") @db.VarChar(66)
  logIndex Int    @map("log_index")

  blockNumber BigInt   @map("block_number")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([txHash, logIndex])
  @@index([blockNumber])
  @@map("processed_logs")
}
